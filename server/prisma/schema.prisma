generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventStatus {
  DRAFT
  PUBLISHED
  SOLD_OUT
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizerApplications OrganizerApplication[]
  organizerProfile      OrganizerProfile?
  orders                Order[]
  tickets               Ticket[]
}

model OrganizerApplication {
  id        String                     @id @default(cuid())
  userId    String
  status    OrganizerApplicationStatus @default(PENDING)
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model OrganizerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id])
  events Event[]
}

model Event {
  id                 String      @id @default(cuid())
  organizerProfileId String
  name               String
  description        String
  bannerUrl          String
  venue              String
  location           String
  eventDate          DateTime    @db.Date
  startTime          DateTime    @db.Time(6)
  endTime            DateTime    @db.Time(6)
  ticketPrice        Int
  ticketCapacity     Int
  status             EventStatus @default(DRAFT)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organizerProfile OrganizerProfile @relation(fields: [organizerProfileId], references: [id])
  orders           Order[]
  tickets          Ticket[]

  @@index([organizerProfileId])
  @@index([status, eventDate])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  eventId     String
  quantity    Int
  subtotal    Int
  platformFee Int
  totalAmount Int
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  event   Event    @relation(fields: [eventId], references: [id])
  payment Payment?
  tickets Ticket[]

  @@index([userId])
  @@index([eventId, status])
}

model Ticket {
  id         String       @id @default(cuid())
  orderId    String
  eventId    String
  userId     String
  ticketCode String       @unique
  status     TicketStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])
  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([eventId, status])
  @@index([userId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  provider          String
  providerPaymentId String        @unique
  amount            Int
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
}
